#!/usr/bin/env bash
# Telemetry SIL: drive the standard EVerest devcontainer from outside VS Code.
#
#   ./tsil build           build the devcontainer image (first time only)
#   ./tsil up              start devcontainer + mqtt-server
#   ./tsil prompt          interactive shell in the container
#   ./tsil exec <cmd...>   run one command in the container
#   ./tsil compile         configure + build + install EVerest into /workspace/dist
#   ./tsil run             run the telemetry SIL (manager, config-telemetry-sil)
#   ./tsil pub [file]      publish one telemetry envelope (default: sample-envelope.json)
#   ./tsil down            stop everything
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
DEVCONTAINER_DIR="${REPO_DIR}/.devcontainer"

# Compose interpolates HOST_WORKSPACE_FOLDER, UID, GID and SSH_AUTH_SOCK out of this file. devrd
# writes the same thing, but refuses when the host ssh-agent holds no keys, which this SIL does not
# need: /dev/null is bound in place of the agent socket instead.
if [ ! -f "${DEVCONTAINER_DIR}/.env" ]; then
    cat > "${DEVCONTAINER_DIR}/.env" <<ENV
# Generated by .devcontainer/telemetry-devcontainer/tsil
ORGANIZATION_ARG=EVerest
REPOSITORY_HOST=github.com
REPOSITORY_USER=git
UID=$(id -u)
GID=$(id -g)
HOST_WORKSPACE_FOLDER=${REPO_DIR}
SSH_AUTH_SOCK=${SSH_AUTH_SOCK:-/dev/null}
ENV
    echo "wrote ${DEVCONTAINER_DIR}/.env"
fi

PROJECT="${DOCKER_COMPOSE_PROJECT_NAME:-$(basename "${REPO_DIR}" | tr '[:upper:]' '[:lower:]')_devcontainer}"

dc() {
    docker compose -p "${PROJECT}" --project-directory "${DEVCONTAINER_DIR}" \
        -f "${DEVCONTAINER_DIR}/docker-compose.yml" \
        -f "${DEVCONTAINER_DIR}/general-devcontainer/docker-compose.devcontainer.yml" \
        -f "${SCRIPT_DIR}/docker-compose.telemetry.yml" \
        "$@"
}

in_container() {
    dc exec -T devcontainer bash -lc "$1"
}

cmd="${1:-}"
shift || true

case "${cmd}" in
    build)   dc build devcontainer mqtt-server ;;
    up)      dc up -d devcontainer mqtt-server ;;
    prompt)  dc exec devcontainer bash -l ;;
    exec)    dc exec devcontainer bash -lc "$*" ;;
    compile)
        in_container "set -e
            cmake -S /workspace -B /workspace/build -G Ninja \
                -DCMAKE_BUILD_TYPE=RelWithDebInfo \
                -DCMAKE_INSTALL_PREFIX=/workspace/dist \
                -DBUILD_TESTING=OFF \
                -DEVEREST_ENABLE_RS_SUPPORT=OFF
            cmake --build /workspace/build --target install -- -j\$(nproc)"
        ;;
    run)
        dc exec devcontainer bash -lc "
            LD_LIBRARY_PATH=/workspace/dist/lib PATH=/workspace/dist/bin:\$PATH \
            /workspace/dist/bin/manager --prefix /workspace/dist \
                --config /workspace/dist/etc/everest/config-telemetry-sil.yaml"
        ;;
    pub)
        payload_file="${1:-${SCRIPT_DIR}/sample-envelope.json}"
        topic="${TOPIC:-everest-telemetry/v1/powermeter_1/livedata}"
        dc exec -T mqtt-server mosquitto_pub -h localhost -t "${topic}" -s < "${payload_file}"
        echo "published to ${topic}"
        ;;
    down)    dc --profile all down --remove-orphans ;;
    *)
        sed -n '2,14p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
        exit 1
        ;;
esac
